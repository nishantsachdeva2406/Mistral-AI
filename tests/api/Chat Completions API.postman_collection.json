  "item": [
    {
      "name": "Happy Path",
      "item": [
        {
          "name": "Valid completion - basic prompt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// TC-API-01: Status code is 200",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// TC-API-02: Response has id",
                  "pm.test(\"Response has id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    pm.expect(json.id).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "// TC-API-03: Response object type is chat.completion",
                  "pm.test(\"Object type is chat.completion\", function () {",
                  "    pm.expect(pm.response.json().object).to.equal(\"chat.completion\");",
                  "});",
                  "",
                  "// TC-API-04: Response has choices array",
                  "pm.test(\"Choices array is present and not empty\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.choices).to.be.an(\"array\").that.is.not.empty;",
                  "});",
                  "",
                  "// TC-API-05: First choice has message content",
                  "pm.test(\"First choice has message content\", function () {",
                  "    const content = pm.response.json().choices[0].message.content;",
                  "    pm.expect(content).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "",
                  "// TC-API-06: Response contains word Paris",
                  "pm.test(\"Response contains word Paris\", function () {",
                  "    const content = pm.response.json().choices[0].message.content;",
                  "    pm.expect(content).to.include(\"Paris\");",
                  "});",
                  "",
                  "// TC-API-07: Usage object is present",
                  "pm.test(\"Usage object has token counts\", function () {",
                  "    const usage = pm.response.json().usage;",
                  "    pm.expect(usage).to.have.property(\"prompt_tokens\");",
                  "    pm.expect(usage).to.have.property(\"completion_tokens\");",
                  "    pm.expect(usage).to.have.property(\"total_tokens\");",
                  "});",
                  "",
                  "// TC-API-08: Response time under 30 seconds",
                  "pm.test(\"Response time is under 30 seconds\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(30000);",
                  "});",
                  "",
                  "// TC-API-09: finish_reason is stop",
                  "pm.test(\"finish_reason is stop\", function () {",
                  "    const finish = pm.response.json().choices[0].finish_reason;",
                  "    pm.expect(finish).to.equal(\"stop\");",
                  "});",
                  "",
                  "// TC-API-10: Model in response matches requested model",
                  "pm.test(\"Model in response matches requested model\", function () {",
                  "    pm.expect(pm.response.json().model).to.equal(\"mistral-small-latest\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"{{model}}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is the capital of France? Answer in one sentence.\"\n    }\n  ]\n  ,\n  \"max_tokens\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/completions",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "chat",
                "completions"
              ]
            }
          },
          "response": []
        },
        {
