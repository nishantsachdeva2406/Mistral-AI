                  "});",
                  "",
                  "pm.test(\"completion_tokens is at most 5\", function () {",
                  "    const usage = pm.response.json().usage;",
                  "    pm.expect(usage.completion_tokens).to.be.at.most(5);",
                  "});",
                  "",
                  "pm.test(\"finish_reason is length\", function () {",
                  "    const finish = pm.response.json().choices[0].finish_reason;",
                  "    pm.expect(finish).to.equal(\"length\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
